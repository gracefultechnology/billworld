  "help": [
    {
      "slug": "pay-your-bill",
      "title": "Pay your bill",
      "mode": "append",
      "topic": "payments",
      "paragraphs": [
        "Residential customers can pay with Visa, MasterCard, Discover or digital wallets such as PayPal, Venmo, Apple Pay and Google Pay at no extra charge, online or through the Customer Support Center.",
        "Make a One-Time Payment works without logging in: you need your account number and your card or checking account details, and you can pay up to $350 more than your current balance.",
        "Mail payments to Atmos Energy, PO Box 740353, Cincinnati, OH 45274-0353 with the bottom of your statement; allow 7 to 10 days to post. Pay by phone at 888-286-6700."
      ],
      "source": "https://www.atmosenergy.com/customer-service/pay-your-bill/"
    },
    {
      "slug": "autopay",
      "title": "Automatic Payment Plan",
      "topic": "autopay",
      "paragraphs": [
        "The Automatic Payment Plan drafts your monthly payment from a bank account or a credit or debit card. Sign up in the Account Center.",
        "Enrolling also signs you up for E-Bill, so statements and payment confirmations arrive by email."
      ],
      "source": "https://www.atmosenergy.com/customer-service/pay-your-bill/"
    },
    {
      "slug": "paperless",
      "title": "E-Bill",
      "mode": "append",
      "topic": "billing",
      "paragraphs": [
        "With E-Bill your statement arrives by email each month with a summary and a link to the Account Center. You need an email address to sign up."
      ],
      "source": "https://www.atmosenergy.com/customer-service/account-options/"
    },
    {
      "slug": "payment-assistance",
      "title": "Installment plans and bill assistance",
      "topic": "assistance",
      "paragraphs": [
        "If you cannot pay the full balance, set up an installment plan at no charge: log in to the Account Center and open the Payment Assistance tab, or call 888-286-6700 during business hours.",
        "Budget Billing spreads your costs using a rolling 12-month average, with no enrollment or monthly fee; it is for residential customers, and paying late can end the plan.",
        "Sharing the Warmth and LIHEAP give bill help through local energy assistance agencies."
      ],
      "source": "https://www.atmosenergy.com/bill-assistance/"
    },
    {
      "slug": "cancel-service",
      "title": "Stop service",
      "topic": "account",
      "paragraphs": [
        "In the Account Center, use Stop Service: enter the date you want your account closed and choose the address where your final bill and future mail should go."
      ],
      "source": "https://www.atmosenergy.com/accountcenter/moveout/editMoveoutDetails.html"
    }
  ],
