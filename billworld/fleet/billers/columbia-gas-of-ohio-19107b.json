  "help": [
    {
      "slug": "pay-your-bill",
      "title": "Payment options",
      "mode": "append",
      "topic": "payments",
      "paragraphs": [
        "Paying from your bank account requires signing in to your online account and has no fee. Credit card, debit card, Apple Pay, Google Pay, PayPal and Venmo payments are processed by Paymentus for a $2.00 convenience fee per transaction.",
        "Without signing in, a One-time Payment (no login needed) accepts cards and digital wallets only. You can also pay by phone at 1-866-694-1828 ($2.00 fee), by mail to P.O. Box 4629, Carol Stream, IL 60197-4629 with your account number, through your bank's bill pay, or in person."
      ],
      "source": "https://www.columbiagasohio.com/bills-and-payments/payment-options"
    },
    {
      "slug": "autopay",
      "title": "AutoPay",
      "topic": "autopay",
      "paragraphs": [
        "AutoPay withdraws the full amount due each month, including current charges and any past-due balance, from your checking or savings account. You still get a monthly bill showing the payment amount and date.",
        "Enroll in your online account under Program Enrollments, then AutoPay, or upload the fillable AutoPay Application."
      ],
      "source": "https://www.columbiagasohio.com/bills-and-payments/billing-programs/autopay"
    },
    {
      "slug": "cancel-autopay",
      "title": "Cancel AutoPay",
      "topic": "autopay",
      "paragraphs": [
        "Log in, select Edit Enrollment and then Cancel Enrollment. You can enroll again later with new payment account details."
      ],
      "steps": [
        "Log in to My Account.",
        "Open Program Enrollments, then AutoPay.",
        "Select Edit Enrollment.",
        "Select Cancel Enrollment."
      ],
      "source": "https://www.columbiagasohio.com/bills-and-payments/billing-programs/autopay"
    },
    {
      "slug": "paperless",
      "title": "Paperless Billing",
      "topic": "billing",
      "paragraphs": [
        "Log in, go to Program Enrollments, select Paperless Billing, confirm the email address for your bill and accept the terms. You get an email each month with the amount due and due date; how you pay does not change."
      ],
      "source": "https://www.columbiagasohio.com/bills-and-payments/billing-programs/paperless"
    },
    {
      "slug": "cancel-service",
      "title": "Stop service",
      "topic": "account",
      "paragraphs": [
        "You can stop service online. Have your account number, the primary account holder's name, phone, SSN or TIN and date of birth, the stop date and a mailing address ready, and submit at least one business day before the stop date.",
        "Some situations, such as moving out of a mobile home, require a call to 1-800-344-4077 to schedule an appointment."
      ],
      "source": "https://www.columbiagasohio.com/services/start-stop-or-move-service"
    }
  ],
