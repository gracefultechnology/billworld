  "help": [
    {
      "slug": "pay-your-bill",
      "title": "Payment Options",
      "topic": "payments",
      "paragraphs": [
        "Sign in to My Account (or the mobile app) to pay your bill from a bank account.",
        "Credit and debit card payments are made through KUBRA EZ-Pay. Residential customers pay a $1.80 fee per payment (non-residential 2.2%); the fee covers KUBRA's service and Xcel Energy does not benefit from it.",
        "You can also call 800-895-4999 to make a one-time payment or pay at a pay station, where transaction fees apply."
      ],
      "source": "https://co.my.xcelenergy.com/s/billing-payment/manage-bill/payment-options",
      "steps": [
        "Sign In to My Account.",
        "Choose Pay Bill.",
        "Select your bank account.",
        "Review and submit."
      ]
    },
    {
      "slug": "autopay",
      "title": "Auto Pay",
      "topic": "autopay",
      "paragraphs": [
        "Auto Pay withdraws your bill payment from your checking or savings account on the due date. You must be enrolled in My Account, and you cannot use a credit card.",
        "If your account has a past-due balance you cannot use Auto Pay. Enrollment is immediate, but the first automatic payment is for your next bill, so sign up before that bill is due. A mail-in application is also available and takes two to three weeks."
      ],
      "source": "https://co.my.xcelenergy.com/s/billing-payment/manage-bill/auto-pay",
      "steps": [
        "Sign in to My Account.",
        "Enter or select your bank information.",
        "Schedule your payment and click Next.",
        "Review the details and select I Agree - Submit."
      ]
    },
    {
      "slug": "payment-assistance",
      "title": "Energy assistance and bill options",
      "topic": "assistance",
      "paragraphs": [
        "Average Monthly Payment (AMP) averages your energy costs over 12 months so you pay a similar amount each month.",
        "Custom Due Date lets you pick your own bill due date for free.",
        "Payment arrangements and energy assistance programs are available if you need help paying; see Energy Assistance for programs in Colorado."
      ],
      "source": "https://co.my.xcelenergy.com/s/billing-payment/manage-bill/payment-options"
    },
    {
      "slug": "billing-history",
      "title": "Bill history",
      "topic": "billing",
      "paragraphs": [
        "Sign in to My Account to see your past bills and payments. You can also view your bill through the mobile app, or through your bank with Bank View and Pay."
      ],
      "source": "https://co.my.xcelenergy.com/s/billing-payment/manage-bill/payment-options"
    },
    {
      "slug": "faq",
      "title": "Frequently asked questions",
      "topic": "faq",
      "paragraphs": [
        "Your email address is your My Account username. If you did not get the verification email after registering, check your spam or junk folder, or call 800-895-4999.",
        "Custom Due Date lets you choose your bill's due date for free."
      ],
      "source": "https://co.my.xcelenergy.com/customersupport/s/article/What-can-I-do-if-I-can-t-log-in-to-My-Account"
    }
  ],
