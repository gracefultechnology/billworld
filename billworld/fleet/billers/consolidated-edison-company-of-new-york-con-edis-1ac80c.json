  "help": [
    {
      "slug": "autopay",
      "title": "Auto Pay",
      "topic": "autopay",
      "paragraphs": [
        "With Auto Pay, Con Edison takes your bill payment automatically from your checking or savings account once you have had time to look over your bill.",
        "Log in to My Account to see whether your account qualifies and to sign up, or call 1-888-925-5016.",
        "If you pay by mail, you can also enroll by marking the Auto Pay box on your payment slip; Con Edison then uses the bank details from your check."
      ],
      "steps": [
        "Log in to My Account.",
        "Open Auto Pay.",
        "Choose your checking or savings account.",
        "Accept the Auto Pay terms and save."
      ],
      "source": "https://www.coned.com/en/accounts-billing/payment-options"
    },
    {
      "slug": "pay-your-bill",
      "mode": "append",
      "title": "Ways to pay your bill",
      "paragraphs": [
        "Con Edison lists a card service fee only for commercial customers (2.99% of the payment, kept by the payment agent); no fee is listed for residential customers paying by credit or debit card. Guest card payments are processed by BillMatrix.",
        "You can also pay as a guest with your account number and ZIP code, by phone at 1-888-925-5016 at any hour, by mailed check or money order, or in cash at an authorized payment agent or a walk-in center."
      ],
      "source": "https://www.coned.com/en/accounts-billing/my-account/pay-bill"
    },
    {
      "slug": "late-payment-charge",
      "title": "Due dates and late payment charges",
      "topic": "billing",
      "paragraphs": [
        "Pay by the due date shown on your bill. Balances left unpaid after the due date are charged a late payment charge of 1.5%.",
        "If you need more time, you can ask for a payment extension of up to 10 days from My Account. The late payment charge still applies, but no collection action is taken during the extension."
      ],
      "source": "https://www.coned.com/en/accounts-billing/my-account/pay-my-bill-guest"
    },
    {
      "slug": "payment-assistance",
      "title": "Payment Plans & Assistance",
      "topic": "assistance",
      "paragraphs": [
        "Payment Agreement: pay an overdue balance over time. Set it up in My Account or call 1-800-752-6633.",
        "Budget Billing: spread your payments evenly across the year so seasonal changes do not swing your bill. Enroll in My Account or by phone.",
        "Energy Affordability Program: a bill discount for customers who receive certain government benefits or whose household income is below the local median.",
        "Customers 62 or older with small annual bills may qualify for quarterly billing, and residential service is protected from shut-off during extreme heat or cold."
      ],
      "steps": [
        "Log in to My Account.",
        "Open Payment Agreement.",
        "Choose the number of monthly payments.",
        "Confirm the agreement."
      ],
      "source": "https://www.coned.com/en/accounts-billing/payment-plans-assistance"
    },
    {
      "slug": "cancel-service",
      "title": "Stop or transfer service",
      "topic": "account",
      "paragraphs": [
        "To stop or transfer service, log in to My Account and choose Stop or Transfer Service with the date you want service to end. You can start new service with or without an online account."
      ],
      "steps": [
        "Log in to My Account.",
        "Choose Stop or Transfer Service.",
        "Pick the date service should stop.",
        "Review and confirm."
      ],
      "source": "https://www.coned.com/en/faqs/frequently-asked-questions"
    }
  ],
